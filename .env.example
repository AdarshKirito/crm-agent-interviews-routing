# Copy to the places noted below. Never commit real keys.
# Application services run locally. Gemini inference can use AI Studio or billed Vertex.
# Select one backend explicitly; never mix backend/model pins within a measured run.

# --- Salesforce orgs (vendor/CRMArena/.env; the MCP server reads the same file) ----
# Use the public CRMArena-Pro logins listed in the CRMArena README
# (https://github.com/SalesforceAIResearch/CRMArena#readme). The B2B password and token
# in CRMArena's own .env.example are stale; the README values worked on 2026-09-27.
SALESFORCE_B2B_USERNAME=
SALESFORCE_B2B_PASSWORD=
SALESFORCE_B2B_SECURITY_TOKEN=
SALESFORCE_B2C_USERNAME=
SALESFORCE_B2C_PASSWORD=
SALESFORCE_B2C_SECURITY_TOKEN=

# --- Model keys (repo-root .env; the agent, scripts and Docker read it) -------------
# AI Studio profile (account quotas apply).
GEMINI_API_KEY=
GOOGLE_API_KEY=            # same value as GEMINI_API_KEY (ADK reads this one)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
# Vertex profile: set BOTH flags above to TRUE and fill the project/location below.
# Authenticate locally with gcloud auth application-default login. Credentials stay
# outside the repo and are mounted read-only by run_systems.sh in Docker mode.
# GOOGLE_CLOUD_PROJECT=your-existing-project
# GOOGLE_CLOUD_LOCATION=global
# VERTEXAI_PROJECT=your-existing-project
# VERTEXAI_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/application_default_credentials.json
# Mistral: verify the active plan/model quota in your account before a larger run.
MISTRAL_API_KEY=
# Groq free tier: Prompt Guard 2 and the policy classifier (small prompts; 8K tokens/min).
GROQ_API_KEY=
# OpenRouter ":free" models: 50 requests/day, used only as a demo fallback.
OPENROUTER_API_KEY=
# Local Ollama (unlimited). From Docker the agent uses http://host.docker.internal:11434.
OLLAMA_MODEL=qwen3:8b
OLLAMA_API_BASE=http://localhost:11434

# --- Pins for measured runs (shell, read by scripts/run_systems.sh) ----------------
# One model per role for the whole run; rate limits are waited out, never switched.
# Approved Vertex experiment profile (paid inference; estimate costs first):
# BIG_MODEL=gemini-3.8-flash
# SMALL_MODEL=gemini-3.1-flash-lite
# POLICY_MODEL=gemini-3.1-flash-lite
# CRMARENA_JUDGE_MODEL=ollama_chat/qwen3:8b      # the same judge for every system
# CRMARENA_JUDGE_PROVIDER=ollama_chat
# CRMARENA_USER_MODEL=ollama_chat/qwen3:8b
# CRMARENA_USER_PROVIDER=ollama_chat
# CRMARENA_THINKING_LEVEL=low
# Historical free-tier pilot used BIG_MODEL=gemini-3.1-flash-lite,
# SMALL_MODEL=ollama_chat/qwen3:8b, POLICY_MODEL=groq/openai/gpt-oss-20b.
# Those results must not be merged with the Vertex experiment.

# --- Local demo (scripts/dev_up.sh) -------------------------------------------------
# CRMROUTE_FALLBACK=1   # on a provider error, try the next model in CRMROUTE_FALLBACK_CHAIN
# CRMROUTE_FALLBACK_CHAIN=gemini-3.8-flash,gemini-3.1-flash-lite,mistral/mistral-small-latest,groq/openai/gpt-oss-120b,openrouter/nvidia/nemotron-3-super-120b-a12b:free,ollama_chat/qwen3:8b

# --- Tracing (optional) --------------------------------------------------------------
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
