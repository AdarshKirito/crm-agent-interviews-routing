# Copy to the places noted below. Never commit real keys.

# --- Salesforce orgs (vendor/CRMArena/.env; the MCP server reads the same file) ----
# Use the public CRMArena-Pro logins listed in the CRMArena README
# (https://github.com/SalesforceAIResearch/CRMArena#readme). The B2B password and token
# in CRMArena's own .env.example are stale; the README values worked on 2026-09-27.
SALESFORCE_B2B_USERNAME=
SALESFORCE_B2B_PASSWORD=
SALESFORCE_B2B_SECURITY_TOKEN=
SALESFORCE_B2C_USERNAME=
SALESFORCE_B2C_PASSWORD=
SALESFORCE_B2C_SECURITY_TOKEN=

# --- Gemini on Vertex AI (agent/.env and your shell for the benchmark) -------------
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
# LiteLLM (benchmark baselines) reads these for vertex_ai models:
VERTEXAI_PROJECT=your-project-id
VERTEXAI_LOCATION=global
# Or AI Studio instead of Vertex (prepaid, with a spending cap):
# GEMINI_API_KEY=...

# --- Grading and the simulated user (shell, used by scripts/run_systems.sh) ---------
# Keep ONE choice for every system and state it in the README.
CRMARENA_JUDGE_MODEL=gemini-3.8-flash
CRMARENA_JUDGE_PROVIDER=vertex_ai
CRMARENA_USER_MODEL=gemini-3.8-flash
CRMARENA_USER_PROVIDER=vertex_ai
# OPENAI_API_KEY=...   # only if you keep the benchmark's original GPT-4o judge

# --- Guard -------------------------------------------------------------------------
# Groq free tier: Prompt Guard 2 only (the agent's prompts do not fit its 8K TPM).
GROQ_API_KEY=

# --- Tracing (optional) --------------------------------------------------------------
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
