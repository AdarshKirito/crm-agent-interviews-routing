+import os
 import re
 import string
 from collections import Counter
@@ -89,9 +90,150 @@ VERTEX_MODELS_MAP = {
   },
   "gemini-2.0-flash-001":{
         "name": "vertex_ai/gemini-2.0-flash-001"
+  },
+  "gemini-3.8-flash": {
+        "name": "vertex_ai/gemini-3.8-flash"
+  },
