diff --git a/crm_sandbox/agents/remote_agent.py b/crm_sandbox/agents/remote_agent.py
new file mode 100644
index 0000000..b32a8d8
--- /dev/null
+++ b/crm_sandbox/agents/remote_agent.py
@@ -0,0 +1,150 @@
+"""Evaluate an agent served by `adk api_server` (or the agents-cli FastAPI app).
+
+The benchmark keeps its own environment, simulated user and graders. This adapter
+only forwards each user turn to the remote agent and hands the agent's reply back
+to the environment as a `respond` action, exactly like the ReAct baseline's final
+<respond> step. The remote agent gets the same task context (metadata) and the same
+customer-facing flag that the baseline receives through its system prompt.
+"""
+import os
+import time
+import uuid
+from typing import Any, Dict, List, Optional, Tuple
+
+import requests
+
+
+class RemoteAgent:
+    def __init__(
+        self,
+        base_url: str,
+        app_name: str,
+        org_type: str,
+        agent_type: str,
+        eval_mode: str = "default",
+        interactive: bool = False,
+        max_user_turns: int = 10,
+        timeout: float = 900.0,
+        user_id: str = "crmarena",
+    ):
+        assert agent_type in ["internal", "external"], "Invalid agent type"
+        self.base_url = base_url.rstrip("/")
+        self.app_name = app_name
+        self.org_type = org_type
+        self.agent_type = agent_type
+        self.eval_mode = eval_mode
+        self.interactive = interactive
+        self.max_user_turns = max_user_turns
+        self.timeout = timeout
+        self.user_id = user_id
+        self.messages: List[Dict[str, str]] = []
+        self.info: Dict[str, Any] = {}
+        self.http = requests.Session()
+        token = os.getenv("CRMROUTE_ID_TOKEN")  # Cloud Run: `gcloud auth print-identity-token`
+        if token:
+            self.http.headers["Authorization"] = f"Bearer {token}"
+
+    def _url(self, path: str) -> str:
+        return f"{self.base_url}{path}"
+
+    def _create_session(self, session_id: str, state: Dict[str, Any]) -> None:
+        res = self.http.post(
+            self._url(f"/apps/{self.app_name}/users/{self.user_id}/sessions"),
+            json={"session_id": session_id, "state": state},
+            timeout=60,
+        )
+        res.raise_for_status()
+
+    def _get_state(self, session_id: str) -> Dict[str, Any]:
+        res = self.http.get(
+            self._url(f"/apps/{self.app_name}/users/{self.user_id}/sessions/{session_id}"),
+            timeout=60,
+        )
+        res.raise_for_status()
+        return res.json().get("state", {})
+
+    def _run_turn(self, session_id: str, text: str) -> Tuple[str, List[Dict[str, Any]]]:
+        res = self.http.post(
+            self._url("/run"),
+            json={
+                "app_name": self.app_name,
+                "user_id": self.user_id,
+                "session_id": session_id,
+                "new_message": {"role": "user", "parts": [{"text": text}]},
+                "streaming": False,
+            },
+            timeout=self.timeout,
+        )
+        res.raise_for_status()
+        events = res.json()
+        return self._final_text(events), events
+
+    @staticmethod
+    def _final_text(events: List[Dict[str, Any]]) -> str:
+        # The workflow's last node writes its reply to state as crm_final_response.
+        for event in reversed(events):
+            delta = (event.get("actions") or {}).get("stateDelta") or {}
+            if isinstance(delta.get("crm_final_response"), str):
+                return delta["crm_final_response"]
+        for event in reversed(events):
+            for part in reversed((event.get("content") or {}).get("parts") or []):
+                if part.get("text") and not part.get("thought"):
+                    return part["text"]
+        return ""
+
+    @staticmethod
+    def _summarize(events: List[Dict[str, Any]]) -> Dict[str, Any]:
+        tool_calls, tool_errors, authors = 0, 0, []
+        for event in events:
+            authors.append(event.get("author"))
+            for part in (event.get("content") or {}).get("parts") or []:
+                if part.get("functionCall"):
+                    tool_calls += 1
+                response = part.get("functionResponse")
+                if response:
+                    body = response.get("response") or {}
+                    if body.get("isError") or body.get("error"):
+                        tool_errors += 1
+        return {"events": len(events), "tool_calls": tool_calls, "tool_errors": tool_errors, "authors": authors}
+
+    def act(self, env, index=None):
+        query, metadata = env.reset(task_index=index)
+        metadata = metadata or {}
+        session_id = f"crmarena-{self.org_type}-{index}-{uuid.uuid4().hex[:8]}"
+        self._create_session(
+            session_id,
+            {
+                "crm_org": self.org_type,
+                "crm_audience": "customer" if self.agent_type == "external" else "employee",
+                "crm_interactive": self.interactive,
+                "crm_task_context": metadata.get("required") or "",
+                "crm_extra_context": (metadata.get("optional") or "") if self.eval_mode == "aided" else "",
+            },
+        )
+        self.messages = []
+        self.info = {"session_id": session_id, "turns": []}
+        observation, reward, done, turns = query, 0, False, 0
+        # One reply per user message; the environment decides when the task ends.
+        while not done and turns <= self.max_user_turns:
+            turns += 1
+            start = time.time()
+            answer, events = self._run_turn(session_id, observation)
+            latency = time.time() - start
+            self.messages.append({"role": "user", "content": observation})
+            self.messages.append({"role": "assistant", "content": answer})
+            self.info["turns"].append({"latency_s": round(latency, 3), **self._summarize(events)})
+            observation, reward, done, info = env.step({"name": "respond", "content": answer})
+            if "end_reason" in info:
+                self.info["end_reason"] = info["end_reason"]
+        state = self._get_state(session_id)
+        usage = state.get("crm_usage") or {}
+        self.info["usage"] = usage
+        self.info["total_cost"] = usage.get("total_cost_usd", 0.0)
+        self.info["calls"] = state.get("crm_calls") or []  # every agent model call, with the model that answered
+        self.info["route"] = state.get("crm_route")
+        self.info["guard"] = state.get("crm_guard")
+        self.info["num_turns"] = (env.current_user_turn, turns)
+        return reward
+
+    def get_messages(self) -> List[Dict[str, str]]:
+        return self.messages
