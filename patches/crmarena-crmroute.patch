@@ -89,9 +90,44 @@ VERTEX_MODELS_MAP = {
   },
   "gemini-2.0-flash-001":{
         "name": "vertex_ai/gemini-2.0-flash-001"
+  },
+  "gemini-3.8-flash": {
+        "name": "vertex_ai/gemini-3.8-flash"
+  },
+  "gemini-3.1-flash-lite": {
+        "name": "vertex_ai/gemini-3.1-flash-lite"
   }
 }
 
+# Same models through the Gemini API (AI Studio); used with --llm_provider gemini.
+GEMINI_API_MODELS_MAP = {
+  "gemini-3.8-flash": {
+        "name": "gemini/gemini-3.8-flash"
+  },
+  "gemini-3.1-flash-lite": {
+        "name": "gemini/gemini-3.1-flash-lite"
+  }
+}
+
+GEMINI3_MODELS = {"gemini-3.8-flash", "gemini-3.1-flash-lite"}
+
+
+def gemini3_completion_kwargs(model_name):
+    """Generation settings shared by every system that calls a Gemini 3.x model.
+
+    Google recommends temperature 1.0 for Gemini 3 (lower values can loop), thinking
+    is fixed at one level everywhere, and the output budget leaves room for
+    thinking tokens. Override with CRMARENA_THINKING_LEVEL / CRMARENA_MAX_TOKENS.
+    """
+    name = model_name.split("/")[-1]
+    if name not in GEMINI3_MODELS:
+        return {}
+    return {
+        "temperature": 1.0,
+        "reasoning_effort": os.getenv("CRMARENA_THINKING_LEVEL", "low"),
+        "max_tokens": int(os.getenv("CRMARENA_MAX_TOKENS", "8192")),
+    }
+
 ### Utils ###
 def parse_wrapped_response(reg_exp, text_phrase):
     match = re.search(reg_exp, text_phrase, re.DOTALL)
