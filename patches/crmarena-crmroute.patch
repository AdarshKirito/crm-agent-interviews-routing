   }
 }
 
+# Same models through the Gemini API (AI Studio); used with --llm_provider gemini.
+GEMINI_API_MODELS_MAP = {
+  "gemini-3.8-flash": {
+        "name": "gemini/gemini-3.8-flash"
+  },
+  "gemini-3.1-flash-lite": {
+        "name": "gemini/gemini-3.1-flash-lite"
+  }
+}
+
+GEMINI3_MODELS = {"gemini-3.8-flash", "gemini-3.1-flash-lite"}
+
+
+def gemini3_completion_kwargs(model_name):
+    """Generation settings shared by every system that calls a Gemini 3.x model (and the
+    local Ollama settings the crmroute agent also uses).
+
+    Google recommends temperature 1.0 for Gemini 3 (lower values can loop), thinking
+    is fixed at one level everywhere, and the output budget leaves room for
+    thinking tokens. Override with CRMARENA_THINKING_LEVEL / CRMARENA_MAX_TOKENS.
+    """
+    if model_name.startswith("ollama"):
+        # same local settings as the crmroute agent: a context window that fits the
+        # prompt (LiteLLM's default is 2048) and thinking off
+        return {"num_ctx": int(os.getenv("CRMARENA_OLLAMA_NUM_CTX", "16384")), "reasoning_effort": "none",
+                "api_base": os.getenv("OLLAMA_API_BASE", "http://localhost:11434")}
+    name = model_name.split("/")[-1]
+    if name not in GEMINI3_MODELS:
+        return {}
+    return {
+        "temperature": 1.0,
+        "reasoning_effort": os.getenv("CRMARENA_THINKING_LEVEL", "low"),
+        "max_tokens": int(os.getenv("CRMARENA_MAX_TOKENS", "8192")),
+    }
+
+### Rate-limit-aware completion ###
+# Measured runs pin one model per role. On a rate limit or overload the call waits and
+# retries the SAME model; a used-up daily quota raises QuotaExhausted so the run stops
+# and can be resumed (--reuse_results) instead of recording failures.
+import json as _json
+import random as _random
+import time as _time
+
+CALLS = []  # one record per LLM call in the current task (run_tasks.py resets it)
+
+
+class QuotaExhausted(RuntimeError):
+    pass
+
+
+def classify_error(err):
+    text = f"{type(err).__name__} {err}"
+    low = text.lower()
+    compact = low.replace(" ", "")
+    if "request too large" in low or "reduce your message size" in low or "context length" in low             or "maximum context" in low or "context_length_exceeded" in low:
+        return "too_large"
+    if "perday" in compact or "per day" in low or "daily" in low:
+        return "daily"
+    if "429" in text or "ratelimit" in compact or "rate limit" in low or "resource_exhausted" in low or "rate_limited" in low:
+        return "rate"
+    if any(s in low for s in ("503", "502", "500 ", "unavailable", "overloaded", "high demand",
+                              "serviceunavailable", "apiconnectionerror", "timeout", "internalservererror")):
+        return "unavailable"
+    return "other"
+
+
+def _retry_after(err):
+    for pattern in (r"retry in ([\d.]+)\s*s", r"retryDelay['\"]?\s*[:=]\s*['\"]?([\d.]+)s"):
+        m = re.search(pattern, str(err), re.I)
+        if m:
+            return float(m.group(1))
+    return None
+
+
+class RequestTooLarge(RuntimeError):
+    """One request is larger than the provider's per-minute input-token quota, so no
+    amount of waiting lets it through (Gemini free tier: 250K input tokens/minute)."""
+
+
+def _check_request_size(kwargs):
+    limit = int(os.getenv("CRMARENA_MAX_REQUEST_TOKENS", "250000"))
+    model = str(kwargs.get("model", ""))
+    if "gemini" not in model or limit <= 0:
+        return
+    try:
+        import litellm
+        tokens = litellm.token_counter(model=model, messages=kwargs.get("messages") or [])
+    except Exception:
+        return
+    if tokens > limit:
+        raise RequestTooLarge(f"request of ~{tokens} tokens exceeds the {limit} input tokens/minute quota of {model}")
+
+
+def completion_with_retry(role, **kwargs):
+    import litellm
+    max_wait = float(os.getenv("CRMARENA_MAX_RETRY_WAIT_S", "900"))
+    waited, attempt, start = 0.0, 0, _time.time()
+    _check_request_size(kwargs)
+    while True:
+        try:
+            res = litellm.completion(**kwargs)
+        except Exception as err:
+            kind = classify_error(err)
+            if kind == "daily":
+                raise QuotaExhausted(f"QUOTA_EXHAUSTED {role} {kwargs.get('model')}: {str(err)[:300]}") from err
+            if kind not in ("rate", "unavailable") or waited >= max_wait:
+                raise
+            delay = (_retry_after(err) or min(60.0, 4.0 * 2 ** attempt)) + _random.uniform(0, 1.5)
+            reason = re.search(r"Quota exceeded for metric: \S+?/(\w+)", str(err))
+            print(f"[retry] {role} {kwargs.get('model')}: {kind}{' (' + reason.group(1) + ')' if reason else ''}; "
+                  f"waiting {delay:.1f}s", flush=True)
+            _time.sleep(delay)
+            waited += delay
+            attempt += 1
+            continue
+        usage = getattr(res, "usage", None)
+        record = {
+            "role": role,
+            "requested": kwargs.get("model"),
+            "answered_by": getattr(res, "model", None),
+            "provider": kwargs.get("custom_llm_provider"),
+            "prompt_tokens": getattr(usage, "prompt_tokens", None),
+            "completion_tokens": getattr(usage, "completion_tokens", None),
+            "attempts": attempt + 1,
+            "waited_s": round(waited, 1),
+            "seconds": round(_time.time() - start, 2),
+        }
+        CALLS.append(record)
+        log_path = os.getenv("CRMARENA_CALL_LOG")
+        if log_path:
+            with open(log_path, "a", encoding="utf-8") as f:
+                f.write(_json.dumps(record) + "\n")
+        return res
+
+
 ### Utils ###
 def parse_wrapped_response(reg_exp, text_phrase):
     match = re.search(reg_exp, text_phrase, re.DOTALL)
